<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>products</title>
</head>
<body>
    <% 
      products.forEach( product=> { %>
           <h1><%= product.name %></h1>
           <p><%=product.category %></p>
          <p><%= product.price%></p>
         <hr>


     <%  })
    %>
</body>
</html>